<Window
    x:Class="PowerPlanTray.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Power Plan Tray Settings">

    <NavigationView x:Name="SettingsNavigationView"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    SelectionChanged="OnNavigationSelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="General" Icon="Setting" Tag="General" IsSelected="True" />
            <NavigationViewItem Content="Power Plans" Tag="PowerPlans">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE7E8;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Automation" Icon="Sync" Tag="Automation" />
            <NavigationViewItem Content="UI" Icon="View" Tag="UI" />
            <NavigationViewItem Content="Advanced" Icon="Repair" Tag="Advanced" />
        </NavigationView.MenuItems>

        <Grid>
        <ScrollViewer x:Name="GeneralPage">
            <StackPanel MaxWidth="640" Padding="32" Spacing="20" HorizontalAlignment="Left">
                <TextBlock Text="General" Style="{ThemeResource TitleTextBlockStyle}" />

                <CheckBox
                    x:Name="DisableCpuBoostCheckBox"
                    Content="Disable CPU Boost"
                    Click="OnDisableCpuBoostClick" />
                <TextBlock x:Name="CpuBoostStatusText" TextWrapping="Wrap" />

                <CheckBox
                    x:Name="StartWithWindowsCheckBox"
                    Content="Start with Windows"
                    Click="OnStartWithWindowsClick" />

                <StackPanel Spacing="8">
                    <TextBlock Text="On launch" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <RadioButtons x:Name="LaunchBehaviorRadioButtons"
                                  SelectionChanged="OnLaunchBehaviorSelectionChanged">
                        <x:String>Start hidden in tray</x:String>
                        <x:String>Show this window</x:String>
                    </RadioButtons>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="PowerPlansPage" Visibility="Collapsed">
            <StackPanel MaxWidth="640" Padding="32" Spacing="20" HorizontalAlignment="Left">
                <TextBlock Text="Power Plans" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="Install or remove the standard Windows power plans. Windows will ask for administrator permission." TextWrapping="Wrap" />
                <StackPanel x:Name="DefaultPlansPanel" Spacing="12" />
                <TextBlock x:Name="PowerPlanStatusText" TextWrapping="Wrap" />

                <TextBlock Text="Show in tray" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
                <TextBlock Text="Choose which installed plans appear in the tray menu." TextWrapping="Wrap" />
                <StackPanel x:Name="VisibilityPlansPanel" Spacing="4" />
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="AutomationPage" Visibility="Collapsed">
            <StackPanel MaxWidth="640" Padding="32" Spacing="20" HorizontalAlignment="Left">
                <TextBlock Text="Automation" Style="{ThemeResource TitleTextBlockStyle}" />

                <StackPanel x:Name="BatteryAcSection" Spacing="12">
                    <TextBlock Text="Battery and AC power" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <ToggleSwitch x:Name="BatteryAcToggle" Header="Automatically switch with the power source" Toggled="OnBatteryAcToggleToggled" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="On Battery" Width="120" VerticalAlignment="Center" />
                        <ComboBox x:Name="BatteryPlanComboBox" Width="260" DisplayMemberPath="Name" SelectionChanged="OnBatteryPlanSelectionChanged" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="On AC Power" Width="120" VerticalAlignment="Center" />
                        <ComboBox x:Name="AcPlanComboBox" Width="260" DisplayMemberPath="Name" SelectionChanged="OnAcPlanSelectionChanged" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Text="App rules" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Switch plans while a configured application is running." TextWrapping="Wrap" />
                    <StackPanel x:Name="AppRulesPanel" Spacing="8" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="AppExecutableTextBox" Width="180" PlaceholderText="steam.exe" />
                        <ComboBox x:Name="AppRulePlanComboBox" Width="220" DisplayMemberPath="Name" />
                        <Button Content="Add" Click="OnAddAppRuleClick" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Browse installed apps" Click="OnBrowseInstalledAppsClick" />
                        <Button Content="Browse for .exe" Click="OnBrowseExecutableClick" />
                    </StackPanel>
                    <TextBlock x:Name="AppRuleStatusText" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Text="Timed switches" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Temporarily use a plan, then restore the previous plan." TextWrapping="Wrap" />
                    <ComboBox x:Name="TimedPlanComboBox" Width="260" HorizontalAlignment="Left" DisplayMemberPath="Name" />
                    <RadioButtons x:Name="TimedDurationRadioButtons" SelectedIndex="0" MaxColumns="4">
                        <x:String>30 min</x:String>
                        <x:String>1 hr</x:String>
                        <x:String>2 hr</x:String>
                        <x:String>4 hr</x:String>
                    </RadioButtons>
                    <Button Content="Apply" HorizontalAlignment="Left" Click="OnApplyTimedSwitchClick" />
                    <TextBlock Text="Custom duration" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <NumberBox x:Name="CustomHoursNumberBox" Header="Hours" Width="120" Minimum="0" Value="0" SpinButtonPlacementMode="Compact" />
                        <NumberBox x:Name="CustomMinutesNumberBox" Header="Minutes" Width="120" Minimum="0" Value="0" SpinButtonPlacementMode="Compact" />
                        <Button Content="Apply custom duration" VerticalAlignment="Bottom" Click="OnApplyCustomTimedSwitchClick" />
                    </StackPanel>
                    <TextBlock x:Name="TimedSwitchErrorText" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                    <StackPanel x:Name="TimedSwitchStatusPanel" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
                        <TextBlock x:Name="TimedSwitchStatusText" VerticalAlignment="Center" />
                        <Button Content="Cancel" Click="OnCancelTimedSwitchClick" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="UiPage" Visibility="Collapsed">
            <StackPanel MaxWidth="640" Padding="32" Spacing="20" HorizontalAlignment="Left">
                <TextBlock Text="UI" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="Choose how the tray popup and Settings window look and size themselves." TextWrapping="Wrap" />
                <ComboBox x:Name="ThemeComboBox" Header="Theme" Width="260" HorizontalAlignment="Left" SelectionChanged="OnUiPreferenceChanged">
                    <x:String>Follow Windows</x:String><x:String>Light</x:String><x:String>Dark</x:String>
                </ComboBox>
                <ComboBox x:Name="PopupSizeComboBox" Header="Tray popup size" Width="260" HorizontalAlignment="Left" SelectionChanged="OnUiPreferenceChanged">
                    <x:String>Small</x:String><x:String>Medium</x:String><x:String>Large</x:String>
                </ComboBox>
                <ComboBox x:Name="PopupTextSizeComboBox" Header="Tray popup text size" Width="260" HorizontalAlignment="Left" SelectionChanged="OnUiPreferenceChanged">
                    <x:String>Small</x:String><x:String>Medium</x:String><x:String>Large</x:String>
                </ComboBox>
                <ComboBox x:Name="SettingsWindowSizeComboBox" Header="Settings window size" Width="260" HorizontalAlignment="Left" SelectionChanged="OnUiPreferenceChanged">
                    <x:String>Small</x:String><x:String>Medium</x:String><x:String>Large</x:String>
                </ComboBox>
                <TextBlock Text="Changes apply immediately. Popup settings take effect the next time it opens." TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="AdvancedPage" Visibility="Collapsed">
            <StackPanel MaxWidth="1000" Padding="32" Spacing="16" HorizontalAlignment="Left">
                <TextBlock Text="Advanced" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="Common Windows power options load immediately. Expand the section below only when you need every setting exposed by this PC." TextWrapping="Wrap" />
                <ComboBox x:Name="AdvancedPlanComboBox"
                          Header="Power plan"
                          DisplayMemberPath="Name"
                          MinWidth="320"
                          SelectionChanged="OnAdvancedPlanSelectionChanged" />
                <TextBlock x:Name="AdvancedStatusText" TextWrapping="Wrap" />
                <Button Content="Restore Windows Defaults" Click="OnRestoreWindowsDefaultsClick" HorizontalAlignment="Left" />
                <StackPanel x:Name="AdvancedSettingsPanel" Spacing="16" />
                <Border BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        HorizontalAlignment="Stretch">
                    <StackPanel>
                        <Button x:Name="ShowAllAdvancedButton" Click="OnShowAllAdvancedClick"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Padding="16,14" CornerRadius="8">
                            <Grid HorizontalAlignment="Stretch">
                                <TextBlock x:Name="AdvancedExpanderHeaderText" Text="Show all advanced settings" Style="{ThemeResource SubtitleTextBlockStyle}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
                <StackPanel x:Name="AllAdvancedSection" Visibility="Collapsed" Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Enable All" Click="OnEnableAllAdvancedClick" />
                        <Button Content="Disable All" Click="OnDisableAllAdvancedClick" />
                    </StackPanel>
                    <TextBlock Text="Profiles capture the visibility and AC/DC values of the settings loaded below." TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save custom configuration/profile" Click="OnSaveProfileClick" />
                        <ComboBox x:Name="AdvancedProfileComboBox" Header="Saved profiles" DisplayMemberPath="Name" MinWidth="220" />
                        <Button Content="Load custom configuration/profile" Click="OnLoadProfileClick" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save to file..." Click="OnExportProfileClick" />
                        <Button Content="Load from file..." Click="OnImportProfileClick" />
                    </StackPanel>
                    <StackPanel x:Name="AllAdvancedSettingsPanel" Spacing="16" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        </Grid>
    </NavigationView>
</Window>
